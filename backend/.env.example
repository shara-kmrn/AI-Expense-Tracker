EXPENSE_TRACKER_APP_NAME="AI-Powered Personal Expense Tracker API"
EXPENSE_TRACKER_APP_VERSION=0.1.0
# Set a fixed Flutter Chrome port (such as 5173) before allowing its origin.
EXPENSE_TRACKER_CORS_ORIGINS=[]
# Generate locally before using authentication. Never commit a real signing key.
# EXPENSE_TRACKER_JWT_SECRET=<generated-signing-key>
EXPENSE_TRACKER_JWT_ISSUER=expense-tracker-api
EXPENSE_TRACKER_JWT_AUDIENCE=expense-tracker-android
EXPENSE_TRACKER_ACCESS_TOKEN_MINUTES=15
EXPENSE_TRACKER_REFRESH_SESSION_DAYS=7
# Optional authenticated SMTP. Set real values only in the ignored .env.
# SMTP_HOST=smtp.example.com
# SMTP_PORT=587
# SMTP_USERNAME=<smtp-login>
# SMTP_PASSWORD=<provider-app-password>
# SMTP_FROM_EMAIL=sender@example.com
# SMTP_SECURITY=starttls
# SMTP_TIMEOUT_SECONDS=5
PASSWORD_RESET_TOKEN_EXPIRE_MINUTES=15
# Leave unset to run the API without a database. URL-encode the password.
# DATABASE_URL=postgresql+psycopg://expense_tracker_app:<encoded-password>@127.0.0.1:5433/expense_tracker_dev
# TEST_DATABASE_URL=postgresql+psycopg://expense_tracker_test_app:<encoded-password>@127.0.0.1:5433/expense_tracker_test
