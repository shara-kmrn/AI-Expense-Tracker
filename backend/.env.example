EXPENSE_TRACKER_APP_NAME="AI-Powered Personal Expense Tracker API"
EXPENSE_TRACKER_APP_VERSION=0.1.0
# Set a fixed Flutter Chrome port (such as 5173) before allowing its origin.
EXPENSE_TRACKER_CORS_ORIGINS=[]
# Leave unset to run the API without a database. URL-encode the password.
# DATABASE_URL=postgresql+psycopg://expense_tracker_app:<encoded-password>@127.0.0.1:5433/expense_tracker_dev
# TEST_DATABASE_URL=postgresql+psycopg://expense_tracker_test_app:<encoded-password>@127.0.0.1:5433/expense_tracker_test
